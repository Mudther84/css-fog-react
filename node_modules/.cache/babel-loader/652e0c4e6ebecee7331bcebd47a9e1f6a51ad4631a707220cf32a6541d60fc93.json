{"ast":null,"code":"import{createSlice}from'@reduxjs/toolkit';const get=(k,d)=>{try{return localStorage.getItem(k)||d;}catch{return d;}};const slice=createSlice({name:'settings',initialState:{lang:get('lang','ar'),theme:get('theme','dark')},reducers:{setLang(state,a){state.lang=a.payload;},toggleTheme(state){state.theme=state.theme==='light'?'dark':'light';}}});export const{setLang,toggleTheme}=slice.actions;export default slice.reducer;","map":{"version":3,"names":["createSlice","get","k","d","localStorage","getItem","slice","name","initialState","lang","theme","reducers","setLang","state","a","payload","toggleTheme","actions","reducer"],"sources":["C:/Users/DELL/Downloads/css-fog-react/css-fog-react/src/store/settingsSlice.js"],"sourcesContent":["import { createSlice } from '@reduxjs/toolkit';\n\nconst get = (k, d) => {\n  try { return localStorage.getItem(k) || d; } catch { return d; }\n};\n\nconst slice = createSlice({\n  name: 'settings',\n  initialState: { lang: get('lang', 'ar'), theme: get('theme', 'dark') },\n  reducers: {\n    setLang(state, a) {\n      state.lang = a.payload;\n    },\n    toggleTheme(state) {\n      state.theme = state.theme === 'light' ? 'dark' : 'light';\n    },\n  },\n});\n\nexport const { setLang, toggleTheme } = slice.actions;\nexport default slice.reducer;\n"],"mappings":"AAAA,OAASA,WAAW,KAAQ,kBAAkB,CAE9C,KAAM,CAAAC,GAAG,CAAGA,CAACC,CAAC,CAAEC,CAAC,GAAK,CACpB,GAAI,CAAE,MAAO,CAAAC,YAAY,CAACC,OAAO,CAACH,CAAC,CAAC,EAAIC,CAAC,CAAE,CAAE,KAAM,CAAE,MAAO,CAAAA,CAAC,CAAE,CACjE,CAAC,CAED,KAAM,CAAAG,KAAK,CAAGN,WAAW,CAAC,CACxBO,IAAI,CAAE,UAAU,CAChBC,YAAY,CAAE,CAAEC,IAAI,CAAER,GAAG,CAAC,MAAM,CAAE,IAAI,CAAC,CAAES,KAAK,CAAET,GAAG,CAAC,OAAO,CAAE,MAAM,CAAE,CAAC,CACtEU,QAAQ,CAAE,CACRC,OAAOA,CAACC,KAAK,CAAEC,CAAC,CAAE,CAChBD,KAAK,CAACJ,IAAI,CAAGK,CAAC,CAACC,OAAO,CACxB,CAAC,CACDC,WAAWA,CAACH,KAAK,CAAE,CACjBA,KAAK,CAACH,KAAK,CAAGG,KAAK,CAACH,KAAK,GAAK,OAAO,CAAG,MAAM,CAAG,OAAO,CAC1D,CACF,CACF,CAAC,CAAC,CAEF,MAAO,MAAM,CAAEE,OAAO,CAAEI,WAAY,CAAC,CAAGV,KAAK